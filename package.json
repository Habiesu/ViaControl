{
  "name": "kengo",
  "version": "1.1.0",
  "description": "Sistema Integral de Gestión de Gandolas y Flota",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "vite build --watch & electron .",
    "dist": "vite build && electron-builder --win nsis",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:publish": "vite build && electron-builder --win nsis --publish always",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "logistica",
    "gandolas",
    "transporte",
    "electron",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "htm": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.viacontrol.app",
    "productName": "ViaControl",
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViaControl",
      "uninstallDisplayName": "ViaControl - Gestión de Flota y Transporte",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "Habiesu",
      "repo": "ViaControl"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "Listas_de_Precios_Fletes.xlsx"
    ],
    "extraResources": [
      "Listas_de_Precios_Fletes.xlsx"
    ]
  }
}